# Pair Trading Tester
ACCOUNT_NAME=Pair Trading Tester
STARTING_CASH=100000
BROKER=sim

# sim = internal paper ledger + Yahoo/Alpaca quotes
# alpaca = Alpaca paper account (recommended for live NYSE routing)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex

# Optional: AI chat / operator briefs (platform still runs without this)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Strategy
Z_ENTRY=2.0
Z_STOP=3.5
Z_LOOKBACK=60
COINT_PVALUE=0.05
MAX_HOLD_DAYS=20
MAX_NOTIONAL_PER_PAIR=10000
MAX_OPEN_PAIRS=8
MAX_GROSS_EXPOSURE_PCT=1.60
PAIR_SPREAD_CORR_LIMIT=0.70
ENGINE_INTERVAL_SECONDS=30
